{
  "manifest_version": 3,
  "name": "TrueWebsiteCloner Bridge",
  "version": "0.1.0",
  "description": "Development bridge between Google Chrome and TrueWebsiteCloner for Windows.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TrueWebsiteCloner"
  }
}
