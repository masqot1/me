<Window x:Class="TrueWebsiteCloner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrueWebsiteCloner" Height="720" Width="1060" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#0D0F14" Foreground="White">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TRUEWEBSITECLONER" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Capture + Offline Builder + Local Runtime · v0.5" Foreground="#8791A5" Margin="0,6,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#151922" BorderBrush="#2B3140" BorderThickness="1" CornerRadius="8" Padding="14,8">
                <TextBlock x:Name="FoundationStatusText" Text="FOUNDATION" FontWeight="SemiBold" Foreground="#9FB5FF" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Desktop bridge" Foreground="#B9C0CF" />
                        <TextBlock x:Name="BridgeStatusText" Grid.Column="1" Text="Starting…" Foreground="#F1C66B" FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Native host registry" Foreground="#B9C0CF" />
                        <TextBlock x:Name="NativeHostStatusText" Grid.Column="1" Text="Checking…" Foreground="#F1C66B" FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Chrome extension" Foreground="#B9C0CF" />
                        <TextBlock x:Name="ExtensionStatusText" Grid.Column="1" Text="Waiting" Foreground="#8791A5" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock Text="Last extension message" Foreground="#7F899B" Margin="0,18,0,4" />
                    <TextBlock x:Name="LastMessageText" Text="—" TextWrapping="Wrap" Foreground="#C9D1DF" MinHeight="42" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="Chrome" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="ChromePathText" Text="Detecting Google Chrome…" Foreground="#8791A5" TextWrapping="Wrap" Margin="0,14,0,14" />
                    <WrapPanel>
                        <Button x:Name="LaunchChromeButton" Content="Launch Chrome" Click="LaunchChromeButton_Click" />
                        <Button Content="Open extension folder" Click="OpenExtensionFolderButton_Click" />
                    </WrapPanel>
                    <TextBlock Text="Extension ID" Foreground="#7F899B" Margin="0,10,0,4" />
                    <TextBlock x:Name="ExtensionIdText" Text="ggcmdgdiopplpbcfinamhjdkbhiknfbk" FontFamily="Consolas" Foreground="#C9D1DF" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Project workspace" FontSize="18" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ProjectFolderTextBox" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Choose folder" Margin="10,0,0,0" Click="ChooseProjectFolderButton_Click" />
                </Grid>
                <WrapPanel Grid.Row="2" Margin="0,16,0,0">
                    <Button Content="Start Test Lab" Click="StartTestLabButton_Click" />
                    <Button Content="Open Test Lab" Click="OpenTestLabButton_Click" />
                    <Button Content="Build Offline Site" Click="BuildOfflineSiteButton_Click" />
                    <Button Content="Start Offline Runtime" Click="StartOfflineRuntimeButton_Click" />
                    <Button Content="Run foundation check" Click="RunFoundationCheckButton_Click" />
                </WrapPanel>
                <Border Grid.Row="3" Background="#101218" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ActivityLogText" FontFamily="Consolas" FontSize="13" Foreground="#AEB8C8" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" Margin="0,16,0,0" Foreground="#667084"
                   Text="V0.5 Local Runtime: loopback only, recorded GET/HEAD only, replay misses never contact the original site." />
    </Grid>
</Window>
