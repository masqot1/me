<Window x:Class="TrueWebsiteCloner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrueWebsiteCloner" Height="900" Width="1200" MinHeight="760" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#0D0F14" Foreground="White">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="TRUEWEBSITECLONER" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Project Workspace + Diagnostics · v0.13" Foreground="#8791A5" Margin="0,6,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#151922" BorderBrush="#2B3140" BorderThickness="1" CornerRadius="8" Padding="14,8">
                <TextBlock x:Name="FoundationStatusText" Text="FOUNDATION" FontWeight="SemiBold" Foreground="#9FB5FF" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold" />
                    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Desktop bridge" Foreground="#B9C0CF" /><TextBlock x:Name="BridgeStatusText" Grid.Column="1" Text="Starting…" Foreground="#F1C66B" FontWeight="SemiBold" /></Grid>
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Native host registry" Foreground="#B9C0CF" /><TextBlock x:Name="NativeHostStatusText" Grid.Column="1" Text="Checking…" Foreground="#F1C66B" FontWeight="SemiBold" /></Grid>
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Chrome extension" Foreground="#B9C0CF" /><TextBlock x:Name="ExtensionStatusText" Grid.Column="1" Text="Waiting" Foreground="#8791A5" FontWeight="SemiBold" /></Grid>
                    <TextBlock Text="Last extension message" Foreground="#7F899B" Margin="0,18,0,4" />
                    <TextBlock x:Name="LastMessageText" Text="—" TextWrapping="Wrap" Foreground="#C9D1DF" MinHeight="42" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                <StackPanel>
                    <TextBlock Text="Chrome" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="ChromePathText" Text="Detecting Google Chrome…" Foreground="#8791A5" TextWrapping="Wrap" Margin="0,14,0,14" />
                    <WrapPanel><Button x:Name="LaunchChromeButton" Content="Launch Chrome" Click="LaunchChromeButton_Click" /><Button Content="Open extension folder" Click="OpenExtensionFolderButton_Click" /></WrapPanel>
                    <TextBlock Text="Extension ID" Foreground="#7F899B" Margin="0,10,0,4" />
                    <TextBlock x:Name="ExtensionIdText" Text="ggcmdgdiopplpbcfinamhjdkbhiknfbk" FontFamily="Consolas" Foreground="#C9D1DF" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="190" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Project catalog" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="CatalogCountText" Grid.Column="1" Text="0 projects" Foreground="#8791A5" VerticalAlignment="Center" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ProjectFolderTextBox" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Choose workspace" Margin="10,0,0,0" Click="ChooseProjectFolderButton_Click" />
                </Grid>
                <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button Content="Refresh Projects" Click="RefreshCatalogButton_Click" />
                    <Button Content="Open Selected" Click="OpenSelectedProjectButton_Click" />
                    <Button Content="Run Diagnostics" Click="RunDiagnosticsButton_Click" />
                    <Button Content="Export Selected" Click="ExportSelectedProjectButton_Click" />
                    <Button Content="Import Package" Click="ImportPackageButton_Click" />
                </WrapPanel>

                <Border Grid.Row="3" Margin="0,4,0,8" Padding="12" Background="#10151D" BorderBrush="#303A4A" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PROJECT HEALTH" Foreground="#7F899B" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="DiagnosticsStatusText" Text="NOT_RUN" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="NEXT ACTION" Foreground="#7F899B" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="DiagnosticsNextActionText" Text="Select a project and run diagnostics." TextWrapping="Wrap" Foreground="#C9D1DF" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="4" Margin="0,2,0,0">
                    <Button Content="Start Test Lab" Click="StartTestLabButton_Click" />
                    <Button Content="Open Test Lab" Click="OpenTestLabButton_Click" />
                    <Button Content="Build Offline Site" Click="BuildOfflineSiteButton_Click" />
                    <Button Content="Start Offline Runtime" Click="StartOfflineRuntimeButton_Click" />
                    <Button Content="Run foundation check" Click="RunFoundationCheckButton_Click" />
                </WrapPanel>

                <DataGrid x:Name="ProjectCatalogGrid" Grid.Row="5" Margin="0,10,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeaderWidth="0"
                          Background="#101218" Foreground="#E7ECF5" BorderBrush="#303848" BorderThickness="1"
                          GridLinesVisibility="None" AlternatingRowBackground="#151A23"
                          MouseDoubleClick="ProjectCatalogGrid_MouseDoubleClick"
                          SelectionChanged="ProjectCatalogGrid_SelectionChanged">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202632"/><Setter Property="Foreground" Value="#BFC9D8"/><Setter Property="Padding" Value="8,6"/><Setter Property="BorderThickness" Value="0"/></Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Project" Binding="{Binding Name}" Width="1.2*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Target" Binding="{Binding TargetUrl}" Width="2*" />
                        <DataGridTextColumn Header="Complete" Binding="{Binding CompletenessDisplay}" Width="78" />
                        <DataGridTextColumn Header="Visual" Binding="{Binding VisualDisplay}" Width="72" />
                        <DataGridTextColumn Header="History" Binding="{Binding SnapshotCount}" Width="62" />
                        <DataGridTextColumn Header="Bodies" Binding="{Binding BodyCount}" Width="58" />
                        <DataGridTextColumn Header="Missing" Binding="{Binding MissingResources}" Width="62" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="6" Background="#101218" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ActivityLogText" FontFamily="Consolas" FontSize="13" Foreground="#AEB8C8" TextWrapping="Wrap" /></ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" Margin="0,16,0,0" Foreground="#667084" Text="V0.13 diagnostics read local project evidence only. No capture is restarted and no external network request is made." />
    </Grid>
</Window>
